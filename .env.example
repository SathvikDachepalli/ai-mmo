# --- Backend server ---
DATABASE_URL=postgresql+asyncpg://rpg:rpg@localhost:5433/rpg
DATABASE_URL_SYNC=postgresql+psycopg2://rpg:rpg@localhost:5433/rpg
REDIS_URL=redis://localhost:6379/0

# --- AI Provider (OpenAI-compatible) ---
# provider: openai | openrouter | deepseek | ollama | deterministic
AI_PROVIDER=openrouter
# Model id as the provider expects it. OpenRouter examples:
#   deepseek/deepseek-chat-v3.1:free   (free tier)
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o-mini
AI_MODEL=deepseek/deepseek-chat-v3.1:free
AI_API_KEY=sk-or-your-openrouter-key
# Leave empty to use the provider default:
#   openai      -> https://api.openai.com/v1
#   openrouter  -> https://openrouter.ai/api/v1
#   deepseek    -> https://api.deepseek.com/v1
#   ollama      -> http://localhost:11434/v1
AI_BASE_URL=

# --- Web search (optional) ---
# Lets the chat-room AI look up current events instead of guessing from
# stale training data. Free tier (1,000 searches/month): https://tavily.com
# Leave empty to disable -- the AI just skips searching.
TAVILY_API_KEY=

# --- Auth ---
# JWT signing secret for account login + socket auth.
# Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000